{
  "name": "pipelinekit-demo",
  "version": "1.0.0",
  "description": "Orders and customers schema for the PipelineKit postgres-to-duckdb blueprint. Matches blueprints/postgres-to-duckdb/contracts/{orders,customers}.yaml: integer keys, five-value status enum, referential integrity from orders.customer_id to customers.customer_id.",
  "tables": {
    "customers": {
      "match": "customers",
      "primaryKey": "customer_id",
      "columns": {
        "customer_id": {
          "strategy": "integer",
          "isPK": true,
          "options": { "min": 1, "max": 2000000000 }
        },
        "email": {
          "strategy": "email"
        },
        "created_at": { "strategy": "timestamp" },
        "_loaded_at": { "strategy": "timestamp" }
      }
    },
    "orders": {
      "match": "orders",
      "primaryKey": "order_id",
      "columns": {
        "order_id": {
          "strategy": "integer",
          "isPK": true,
          "options": { "min": 1, "max": 2000000000 }
        },
        "customer_id": {
          "strategy": "integer",
          "foreignKey": { "table": "customers", "column": "customer_id" }
        },
        "status": {
          "strategy": "enum",
          "options": {
            "values": ["pending", "processing", "shipped", "delivered", "cancelled"],
            "weights": [15, 20, 25, 35, 5]
          }
        },
        "amount": {
          "strategy": "integer",
          "options": { "min": 500, "max": 50000 }
        },
        "created_at": { "strategy": "timestamp" },
        "_loaded_at": { "strategy": "timestamp" }
      }
    }
  },
  "relationships": [
    {
      "targetTable": "orders",
      "sourceTable": "customers",
      "cardinality": { "strategy": "poisson", "mean": 4.2, "min": 0, "max": 30 }
    }
  ]
}